{% schema %}
{
  "name": "Product Reviews",
  "target": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#FFB800"
    }
  ]
}
{% endschema %}

<div class="tw-product-reviews" style="background: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};">
  <div class="tw-pr-header">
    <h2 class="tw-pr-title">Customer Reviews</h2>
    <button class="tw-pr-btn-write" onclick="document.getElementById('tw-pr-form-modal').style.display='block'">Write a Review</button>
  </div>

  <div id="tw-pr-list" class="tw-pr-list">
    <p class="tw-pr-loading">Loading reviews...</p>
  </div>

  <!-- Write Review Modal -->
  <div id="tw-pr-form-modal" class="tw-pr-modal" style="display: none;">
    <div class="tw-pr-modal-content" style="background: {{ block.settings.bg_color }};">
      <span class="tw-pr-close" onclick="document.getElementById('tw-pr-form-modal').style.display='none'">&times;</span>
      <h3>Write a Review</h3>
      <form id="tw-pr-form" onsubmit="submitTwReview(event)">
        <input type="hidden" name="productId" value="{{ product.id }}">
        
        <label>Rating (1-5)</label>
        <select name="rating" required>
          <option value="5">5 Stars</option>
          <option value="4">4 Stars</option>
          <option value="3">3 Stars</option>
          <option value="2">2 Stars</option>
          <option value="1">1 Star</option>
        </select>
        
        <label>Your Name</label>
        <input type="text" name="author" required placeholder="John Doe">
        
        <label>Your Review</label>
        <textarea name="body" required rows="4" placeholder="What did you like about this product?"></textarea>
        
        <button type="submit" class="tw-pr-btn-submit">Submit Review</button>
      </form>
    </div>
  </div>
</div>

<style>
  .tw-product-reviews {
    padding: 20px;
    border-radius: 8px;
    font-family: inherit;
    border: 1px solid #f0f0f0;
    margin-top: 20px;
  }
  .tw-pr-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #f0f0f0;
    padding-bottom: 15px;
    margin-bottom: 15px;
  }
  .tw-pr-title { margin: 0; font-size: 20px; font-weight: 600; }
  .tw-pr-btn-write, .tw-pr-btn-submit {
    background: #000;
    color: #fff;
    border: none;
    padding: 10px 16px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
  }
  .tw-pr-review { margin-bottom: 20px; border-bottom: 1px solid #f9f9f9; padding-bottom: 15px; }
  .tw-pr-stars { color: {{ block.settings.star_color }}; font-size: 16px; margin-bottom: 5px; }
  .tw-pr-author { font-weight: 600; font-size: 14px; margin-bottom: 5px; }
  .tw-pr-body { font-size: 14px; line-height: 1.5; color: #555; }
  
  .tw-pr-modal {
    position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%;
    overflow: auto; background-color: rgba(0,0,0,0.5); display: flex;
    align-items: center; justify-content: center;
  }
  .tw-pr-modal-content {
    background-color: #fefefe; padding: 25px; border-radius: 8px; width: 100%; max-width: 450px; position: relative;
  }
  .tw-pr-close {
    position: absolute; right: 20px; top: 15px; color: #aaa; font-size: 28px; font-weight: bold; cursor: pointer;
  }
  .tw-pr-modal-content label { display: block; margin-top: 15px; font-size: 13px; font-weight: 600; }
  .tw-pr-modal-content input, .tw-pr-modal-content select, .tw-pr-modal-content textarea {
    width: 100%; padding: 10px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;
  }
  .tw-pr-btn-submit { margin-top: 20px; width: 100%; }
</style>

<script>
  function renderStars(rating) {
    return '★'.repeat(rating) + '☆'.repeat(5 - rating);
  }

  function loadTwReviews() {
    const list = document.getElementById('tw-pr-list');
    const productId = "{{ product.id }}";
    if (!productId) {
      list.innerHTML = "<p>Product not found.</p>";
      return;
    }

    fetch(`/apps/tw-api?action=get-reviews&productId=${productId}`)
      .then(res => res.json())
      .then(res => {
        if (res.success && res.data.length > 0) {
          list.innerHTML = res.data.map(r => `
            <div class="tw-pr-review">
              <div class="tw-pr-stars">${renderStars(r.rating)}</div>
              <div class="tw-pr-author">${r.author}</div>
              <div class="tw-pr-body">${r.body}</div>
            </div>
          `).join('');
        } else {
          list.innerHTML = "<p>No reviews yet. Be the first to write one!</p>";
        }
      })
      .catch(() => {
        list.innerHTML = "<p>Failed to load reviews.</p>";
      });
  }

  function submitTwReview(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    formData.append('action', 'submit-review');
    const btn = form.querySelector('.tw-pr-btn-submit');
    btn.innerText = "Submitting...";
    btn.disabled = true;

    fetch('/apps/tw-api', {
      method: 'POST',
      body: formData
    })
    .then(res => res.json())
    .then(res => {
      if (res.success) {
        document.getElementById('tw-pr-form-modal').style.display = 'none';
        form.reset();
        loadTwReviews();
      } else {
        alert("Error: " + res.error);
      }
    })
    .catch(() => alert("Network error"))
    .finally(() => {
      btn.innerText = "Submit Review";
      btn.disabled = false;
    });
  }

  document.addEventListener("DOMContentLoaded", loadTwReviews);
</script>

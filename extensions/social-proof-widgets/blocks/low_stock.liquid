{% if product.selected_or_first_available_variant.inventory_quantity > 0 and product.selected_or_first_available_variant.inventory_quantity <= block.settings.threshold %}
<div class="tw-low-stock-alert" style="background-color: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
    <line x1="12" y1="9" x2="12" y2="13"></line>
    <line x1="12" y1="17" x2="12.01" y2="17"></line>
  </svg>
  <span>
    <strong>Hurry!</strong> Only <strong>{{ product.selected_or_first_available_variant.inventory_quantity }}</strong> items left in stock.
  </span>
</div>
{% endif %}

<style>
  .tw-low-stock-alert {
    display: flex;
    align-items: center;
    padding: 10px 15px;
    border-radius: 4px;
    margin: 10px 0;
    font-size: 14px;
    border-left: 4px solid #ff5252;
  }
</style>

{% schema %}
{
  "name": "Low Stock Alert",
  "target": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffebee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#b71c1c"
    },
    {
      "type": "number",
      "id": "threshold",
      "label": "Show when stock is below",
      "default": 10
    }
  ]
}
{% endschema %}
